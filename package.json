{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Chat backend with PostgreSQL (users/chats) and Firebase Firestore (messages/read receipts)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "emulator": "npx -y firebase-tools@13 emulators:start --only firestore --project chat-backend-dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "firebase-admin": "^12.7.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.10.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.9"
  }
}
