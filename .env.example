PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker-compose.yml starts one with these credentials)
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat?schema=public

# Firebase / Firestore
FIREBASE_PROJECT_ID=chat-backend-dev

# Option A: local development and tests against the Firestore emulator
FIRESTORE_EMULATOR_HOST=localhost:8080

# Option B: a real Firebase project. Remove FIRESTORE_EMULATOR_HOST and point
# this at a service-account key file (never commit it).
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
